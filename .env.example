# NASA API key for the Asteroids app's NeoWs feed.
# Get a free key at https://api.nasa.gov/ (raises the limit from DEMO_KEY's
# ~30 req/hr to ~1,000). For local dev, copy this to `.env.local` (gitignored)
# and fill it in. In CI it comes from the VITE_NASA_API_KEY GitHub Actions secret.
VITE_NASA_API_KEY=

# Spotify — powers the live "top 10" in the Music window. These are SERVER-SIDE
# only (no VITE_ prefix, never bundled into the browser). Used by
# tools/spotify-data/fetch-top-tracks.mjs at build time. See that folder's
# README for how to create the app and obtain the refresh token. In CI they come
# from GitHub Actions secrets of the same names.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional: short_term (default, ~4 weeks) | medium_term | long_term
SPOTIFY_TIME_RANGE=
